#!/bin/bash
# .githooks/pre-commit — nxstyle check on staged board files
#
# Install:
#   git config core.hooksPath .githooks

WORKSPACE="$(git rev-parse --show-toplevel)/.."

# Locate the NuttX tools directory.  The nuttx tree may sit directly under
# the workspace or one level down inside an "openvela" checkout.
NXTOOLS=""
for cand in "$WORKSPACE/nuttx/tools" "$WORKSPACE/openvela/nuttx/tools"; do
  if [ -f "$cand/nxstyle.c" ]; then
    NXTOOLS="$cand"
    break
  fi
done

if [ -z "$NXTOOLS" ]; then
  echo "WARNING: nuttx tools not found, skipping style check"
  exit 0
fi

NXSTYLE="$NXTOOLS/nxstyle"

# Build nxstyle with the host compiler if missing.  nxstyle is a plain
# host utility, so compile the source directly rather than going through
# Makefile.host (which pulls in the cross toolchain).
if [ ! -x "$NXSTYLE" ]; then
  echo "nxstyle not found, building..."
  cc -o "$NXSTYLE" "$NXTOOLS/nxstyle.c" 2>/dev/null
fi

if [ ! -x "$NXSTYLE" ]; then
  echo "WARNING: cannot build nxstyle, skipping style check"
  exit 0
fi

FAIL=0
for f in $(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(c|h)$'); do
  OUTPUT=$("$NXSTYLE" "$f" 2>&1 | grep -v "Path relative" || true)
  if [ -n "$OUTPUT" ]; then
    echo "--- $f ---"
    echo "$OUTPUT"
    FAIL=1
  fi
done

if [ $FAIL -ne 0 ]; then
  echo ""
  echo "nxstyle check failed. Fix errors or bypass with: git commit --no-verify"
  exit 1
fi
